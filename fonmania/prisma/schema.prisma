generator cliente {
  provider = "prisma-client-js"
}

datasource fonmania {
  provider = "postgresql" // Cambia a mysql/sqlite si lo prefieres
  url      = env("DATABASE_URL")
}

model Categoria {
  ID                Int                @id @default(autoincrement())
  nombre            String             @unique
  detallesCategoria DetalleCategoria[]
  productos         Producto[]
}

model DetalleCategoria {
  ID              Int    @id @default(autoincrement())
  categoriaID     Int
  nombre_atributo String
  tipo_dato       String
  unidad          String

  categoria        Categoria         @relation(fields: [categoriaID], references: [ID])
  productoDetalles ProductoDetalle[]

  @@unique([categoriaID, nombre_atributo])
}

model Producto {
  ID          Int    @id @default(autoincrement())
  nombre      String
  categoriaID Int
  stock       Int
  precio      Float
  marcaID     Int
  descripcion String

  categoria      Categoria           @relation(fields: [categoriaID], references: [ID])
  marca          Marca               @relation(fields: [marcaID], references: [ID])
  imagenes       ImagenProducto[]
  detalles       ProductoDetalle[]
  promociones    ProductoPromocion[]
  pedidoDetalles PedidoDetalle[]

  favoritos Favorito[]
}

model ImagenProducto {
  ID         Int    @id @default(autoincrement())
  productoID Int
  url        String // Ruta o enlace a la imagen
  tipo       String // "principal", "galeria", "zoom", etc.
  orden      Int? // Para definir el orden de visualización (opcional)

  producto Producto @relation(fields: [productoID], references: [ID], onDelete: Cascade)
}

model ProductoDetalle {
  ID                 Int    @id @default(autoincrement())
  productoID         Int
  detallecategoriaID Int
  valor              String

  producto         Producto         @relation(fields: [productoID], references: [ID])
  detalleCategoria DetalleCategoria @relation(fields: [detallecategoriaID], references: [ID])
}

model Marca {
  ID        Int        @id @default(autoincrement())
  nombre    String     @unique
  productos Producto[]
}

model ProductoPromocion {
  ID          Int @id @default(autoincrement())
  productoID  Int
  promocionID Int

  producto  Producto  @relation(fields: [productoID], references: [ID])
  promocion Promocion @relation(fields: [promocionID], references: [ID])
}

model Promocion {
  ID                 Int    @id @default(autoincrement())
  nombre             String
  descuento          Float
  codigo_promocional String @unique
  inicio_promocion   String
  fin_promocion      String

  productos ProductoPromocion[]
}

model Pedido {
  ID           Int    @id @default(autoincrement())
  fecha        String
  estado       String
  total        Float
  usuarioID    Int
  metodoPagoID Int?

  usuario    Usuario         @relation(fields: [usuarioID], references: [ID])
  metodoPago MetodoPago?     @relation("MetodoPagoPedidos", fields: [metodoPagoID], references: [ID])
  detalles   PedidoDetalle[]
  envio      Envio?
}

model PedidoDetalle {
  ID              Int   @id @default(autoincrement())
  productoID      Int
  pedidoID        Int
  cantidad        Int
  precio_unitario Float
  subtotal        Float

  producto Producto @relation(fields: [productoID], references: [ID])
  pedido   Pedido   @relation(fields: [pedidoID], references: [ID])
}

model Envio {
  ID                Int    @id @default(autoincrement())
  pedidoID          Int    @unique
  empresa           String
  codigoSeguimiento String
  estado            String
  fecha_envio       String
  fecha_entrega     String

  pedido Pedido @relation(fields: [pedidoID], references: [ID])
}

model MetodoPago {
  ID      Int      @id @default(autoincrement())
  nombre  String
  pedidos Pedido[] @relation("MetodoPagoPedidos")
}

model Usuario {
  ID             Int      @id @default(autoincrement())
  correo         String   @unique
  password       String
  fecha_creacion DateTime
  rolpermisoID   Int
  nombre         String
  direccion      String
  DNI            Int      @unique

  rolPermiso RolPermiso @relation(fields: [rolpermisoID], references: [ID])
  pedidos    Pedido[]

  favoritos Favorito[]
}

model Favorito {
  ID         Int @id @default(autoincrement())
  usuarioID  Int
  productoID Int

  usuario  Usuario  @relation(fields: [usuarioID], references: [ID])
  producto Producto @relation(fields: [productoID], references: [ID])
}

model Rol {
  ID          Int          @id @default(autoincrement())
  nombre      String
  rolPermisos RolPermiso[]
}

model Permiso {
  ID          Int          @id @default(autoincrement())
  descripcion String
  rolPermisos RolPermiso[]
}

model RolPermiso {
  ID        Int @id @default(autoincrement())
  rolID     Int
  permisoID Int

  rol      Rol       @relation(fields: [rolID], references: [ID])
  permiso  Permiso   @relation(fields: [permisoID], references: [ID])
  usuarios Usuario[]
}
